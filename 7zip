# 7-Zip с AES-256 и криптиране на имената на файловете
sudo apt install p7zip-full
7z a -t7z -mhe=on -p backup.7z ./.ssh/
  # Част      # Значение
       7z	      Стартира програмата 7-Zip
        a       Add – добавя файлове към архив или създава нов
     -t7z       Използва архивния формат .7z
  -mhe=on       Криптира и заглавната информация на архива, включително имената на файловете
       -p       Изисква интерактивно въвеждане на парола
backup.7z       Име на архива, който ще бъде създаден
  ./.ssh/       Папката, която ще архивира
# test
7z t backup.7z
# list
7z l backup.7z
# extract
7z x backup.7z
