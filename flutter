ако достъпа е до подпапка:
https://host.com/flutter

flutter build web --base-href /flutter/

[nginx]
    location = /flutter {
        return 301 /flutter/;
    }

    location ^~ /flutter/ {
        root /var/www/html;
        autoindex off;

        try_files $uri $uri/ /flutter/index.html;
    }

    location /flutter {
        alias /var/www/html/flutter/;
        autoindex off;
    }
